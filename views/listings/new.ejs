<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
  <div class="col-8 offset-2">
    <!-- <br /><br /> -->
    <h3>Create a New Listing</h3>
    <form 
      method="POST" 
      action="/listings" 
      class="needs-validation" 
      enctype="multipart/form-data"
      >
      <!-- ✅ TITLE -->
      <div class="mb-3">
        <label class="form-label">Title</label>
        <input 
          name="listing[title]"
          placeholder="Add a catch title"
          type="text"
          class="form-control"
          required
        />
        <div class="invalid-feedback">title looks good!</div>
      </div>

      <!-- DESCRIPTION -->
      <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea 
          name="listing[description]" 
          class="form-control"
          required>
        </textarea>
      </div>

      <!-- IMAGE -->
    <div class="mb-3">
        <label class="form-label">Upload Listing Image</label>
        <input 
          name="listing[image]"
          placeholder="enter image URL"
          type="file"
          class="form-control"
          required
        />
      </div> 

      <!-- PRICE + COUNTRY -->
      <div class="row">
        <div class="col-md-6 mb-3">
          <label class="form-label">Price</label>
          <input 
            name="listing[price]"
            type="number"
            class="form-control"
            required
          />
          <div class="invalid-feedback">Please should be valid</div>
        </div>

        <div class="col-md-6 mb-3">
          <label class="form-label">Country</label>
          <input 
            name="listing[country]"
            type="text"
            class="form-control"
            required
          />
          <div class="invalid-feedback">Country name should be valid</div>
        </div>
      </div>

      <!-- LOCATION -->
      <div class="mb-3">
        <label class="form-label">Location</label>
        <input
          name="listing[location]"
          class="form-control"
          required
        />
        <div class="invalid-feedback">should be location</div>
      </div>

      <!-- BUTTON -->
      <button class="btn btn-danger btn-sm">Add</button>

    </form>
  </div>
</div>
